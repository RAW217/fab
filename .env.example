# Names only; do not commit real values. Hosted: set through Site runtime secrets.
# Local Worker development: copy this to ignored .dev.vars and fill in values.
FOODICS_ENVIRONMENT=sandbox
FOODICS_CLIENT_ID=
FOODICS_CLIENT_SECRET=
FOODICS_REDIRECT_URI=https://zabonex-fnb-prediction-ui.tizab6.chatgpt.site/api/integrations/foodics/callback
# Base64 encoding of exactly 32 random bytes. Keep it stable and back it up safely.
FOODICS_TOKEN_ENCRYPTION_KEY=
# Optional: >=32 random characters, shared ONLY with a secure HTTP cron runner.
FOODICS_SCHEDULER_SECRET=
